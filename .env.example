EXPO_PUBLIC_FB_APP_ID=

# --- Auth (ver docs/AUTH_SETUP.md y docs/RELEASE.md) ---
# Sign in with Apple: ponlo en true solo con el Apple Developer Program pagado
EXPO_PUBLIC_APPLE_SIGN_IN=false
# Supabase: Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google Cloud → Credentials (OAuth client IDs)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# iOS client ID al revés: com.googleusercontent.apps.XXXX (solo build, no va al bundle)
GOOGLE_IOS_URL_SCHEME=
# Páginas legales (por defecto https://shory-legal.vercel.app/privacy y /terms, publicadas desde legal/)
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=

# --- EAS (lo imprime `eas init`) ---
EAS_PROJECT_ID=

# --- Pagos (RevenueCat) ---
# Llave pública del SDK: test_… (Test Store) en desarrollo, appl_… en el build de App Store
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
